# Railway / production — deep-web auto-sync + frontend push
HOST=0.0.0.0
PORT=8080
DEEP_WEB_AUTO_SYNC=true
DEEP_WEB_SYNC_INTERVAL_HOURS=6
DEEP_WEB_UNCENSORED=true
DEEP_WEB_PUBLISH_FULL_TEXT=true

# POST full corpus JSON to your frontend API on every sync
CORPUS_WEBHOOK_URL=
CORPUS_WEBHOOK_SECRET=

# Optional: Vercel/Netlify deploy hook to rebuild frontend after corpus update
FRONTEND_DEPLOY_HOOK_URL=

# Comma-separated browser origins (or leave empty to allow all)
CORS_ORIGIN=

# Scribd (authenticated deep-web)
SCRIBD_SESSION_COOKIE=
SCRIBD_LIBRARY_URL=https://www.scribd.com/home
